# 3PL warehouse stock sync - copy to .env (git ignores it), fill in, chmod 600.

# ── Warehouse database (MySQL) ───────────────────────────────────────────────
# The same production login the other cron jobs use (see iTrend-Cron-Scripts/*/.env).
WAREHOUSE_DB_HOST=                        # REQUIRED
WAREHOUSE_DB_PORT=3306
WAREHOUSE_DB_NAME=                        # REQUIRED  e.g. gen_ai_db
WAREHOUSE_USER=                           # REQUIRED
WAREHOUSE_PASSWORD=

# ── Tactical Logistic Solutions - US  (https://tacticalwarehousing.com) ──────
TACTICAL_USERNAME=                        # REQUIRED  the login e-mail
TACTICAL_PASSWORD=                        # REQUIRED

# ── GTI / myGTI IMS - CA  (https://ims.gti-co.com/view-users.php) ────────────
GTI_USERNAME=                             # REQUIRED
GTI_PASSWORD=                             # REQUIRED

# ── Ideal Logistics on Extensiv - UK  (https://app.extensiv.com/hub/landing) ─
IDEAL_USERNAME=                           # REQUIRED  the login e-mail
IDEAL_PASSWORD=                           # REQUIRED

# ── TheFbaPrep - UK / DE  (https://thefbaprep.com/cabinet/users/login) ───────
FBAPREP_USERNAME=                         # REQUIRED  the login e-mail
FBAPREP_PASSWORD=                         # REQUIRED

# ── Optional ─────────────────────────────────────────────────────────────────
# false = show the browser window (needs a display) - for a first login that asks for a code.
HEADLESS=true
# Seconds to wait for any one page element before giving up.
BROWSER_TIMEOUT_SECONDS=90
# GTI: include products with zero stock, so a sold-out ASIN is written as 0.
GTI_INCLUDE_ZERO_STOCK=true
# TheFbaPrep: marketplace for an inbound whose warehouse is neither UK nor DE.
FBAPREP_DEFAULT_MARKETPLACE=UK
# TheFbaPrep: only count inbounds in these statuses (comma-separated). Empty = all inbounds.
FBAPREP_INBOUND_STATUSES=

# ── Security ─────────────────────────────────────────────────────────────────
# The database connection must be TLS-encrypted (a plain-text server is refused). Set a CA file
# to also verify the server's certificate, e.g. the RDS / MySQL server CA bundle.
WAREHOUSE_DB_SSL_CA=
